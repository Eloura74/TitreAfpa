# ============================================
# CONFIGURATION BACKEND - TEMPLATE
# ============================================
# INSTRUCTIONS :
# 1. Copier ce fichier en .env
# 2. Remplacer toutes les valeurs par vos vraies clés
# 3. NE JAMAIS committer le fichier .env

# ============================================
# SERVEUR
# ============================================
PORT=5001
NODE_ENV=development

# ============================================
# BASE DE DONNÉES MONGODB
# ============================================
# Format : mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://votre_utilisateur:votre_mot_de_passe@cluster0.xxxxx.mongodb.net/votre_db?retryWrites=true&w=majority

# ============================================
# AUTHENTIFICATION JWT
# ============================================
# IMPORTANT : Générer un secret fort avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre_secret_jwt_de_64_caracteres_minimum_genere_aleatoirement
JWT_EXPIRE=2h

# ============================================
# CLOUDINARY (Stockage images)
# ============================================
# Obtenir sur : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================
# STRIPE (Paiements)
# ============================================
# Clé de test : https://dashboard.stripe.com/test/apikeys
# Clé de prod : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_votre_cle_stripe

# ============================================
# PAYPAL (Paiements)
# ============================================
# Obtenir sur : https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=votre_paypal_client_id
PAYPAL_CLIENT_SECRET=votre_paypal_client_secret
PAYPAL_MODE=sandbox
# En production, mettre : PAYPAL_MODE=live

# ============================================
# EMAIL (Gmail SMTP)
# ============================================
# IMPORTANT : Utiliser un mot de passe d'application, PAS votre mot de passe Gmail
# Créer ici : https://myaccount.google.com/apppasswords
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=noreply@votresite.com
EMAIL_FROM_NAME=Fabien Licata Photographie

# ============================================
# FRONTEND (URL pour CORS et emails)
# ============================================
# En développement :
FRONTEND_URL=http://localhost:5173

# En production (à changer) :
# FRONTEND_URL=https://votre-site.vercel.app

# ============================================
# SÉCURITÉ (Optionnel)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
SESSION_SECRET=votre_session_secret_64_caracteres

# ============================================
# MONITORING (Optionnel - pour plus tard)
# ============================================
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
