# ============================================
# CONFIGURATION FRONTEND (Vite/React)
# ============================================
# INSTRUCTIONS :
# 1. Copier ce fichier en .env.local
# 2. Remplacer par vos vraies valeurs
# 3. Redémarrer le serveur Vite après modification

# ============================================
# API BACKEND
# ============================================
# En développement (proxy Vite configuré) :
VITE_API_URL=http://localhost:5001

# En production Vercel :
# VITE_API_URL=https://votre-backend.vercel.app

# ============================================
# PAYPAL (Client-side)
# ============================================
# Clé publique PayPal (seulement le Client ID)
# Mode Sandbox : https://developer.paypal.com/dashboard/applications/sandbox
# Mode Live : https://developer.paypal.com/dashboard/applications/live
VITE_PAYPAL_CLIENT_ID=votre_paypal_client_id_public

# ============================================
# ANALYTICS (Optionnel)
# ============================================
# Google Analytics 4
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# MONITORING (Optionnel)
# ============================================
# Sentry DSN (pour tracking d'erreurs)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# FEATURE FLAGS (Optionnel)
# ============================================
# Activer/désactiver des fonctionnalités en test
# VITE_FEATURE_ALBUM_VIEW=true
# VITE_FEATURE_TARIF_V2=true
# VITE_FEATURE_PWA=false
